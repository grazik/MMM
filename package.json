{
  "name": "mmm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:server": "vite build --config vite.server.config.ts --watch",
    "build": "vite build --config vite.config.ts && vite build --config vite.server.config.ts",
    "start": "node dist/main.js",
    "fetch": "node dist/fetch.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "croner": "^10.0.1",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
